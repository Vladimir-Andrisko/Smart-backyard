<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9"
    android:padding="16dp"
    tools:context=".AnalyticsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnAnalyticsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="#7F8C8D"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_analytics"
            android:textColor="#2C3E50"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_select_zone"
            android:textColor="#2C3E50"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="#F4F6F9"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_select_period"
            android:textColor="#2C3E50"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPeriod24h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_period_24h"
                android:textSize="11sp"
                android:backgroundTint="#2E4053"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="0dp" />

            <Button
                android:id="@+id/btnPeriod7d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_period_7d"
                android:textSize="11sp"
                android:backgroundTint="#7F8C8D"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="0dp" />

            <Button
                android:id="@+id/btnPeriod30d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_period_30d"
                android:textSize="11sp"
                android:backgroundTint="#7F8C8D"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="0dp" />

            <Button
                android:id="@+id/btnPeriodCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_period_custom"
                android:textSize="11sp"
                android:backgroundTint="#7F8C8D"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelCustomDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDateFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_date_from"
                android:textColor="#E67E22"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDateTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_date_to"
                android:textColor="#E67E22"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="#3498DB" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legend_soil_moisture"
                android:textSize="12sp"
                android:textColor="#2C3E50"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="#95A5A6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelNoDataState"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="#FEF9E7"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳"
                android:textSize="24sp"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_data_state_title"
                    android:textColor="#B7950B"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvNoDataDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_data_state_desc"
                    android:textColor="#7D6608"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chartPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analytics_interpretation_hint"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed"
            android:textAlignment="center" />
    </LinearLayout>

</LinearLayout>