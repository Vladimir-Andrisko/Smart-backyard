<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9"
    android:padding="16dp"
    tools:context=".CatalogFormActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnFormBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="#7F8C8D"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_culture"
            android:textColor="#2C3E50"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_culture_name"
            android:textColor="#2C3E50"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCultureName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="#F4F6F9"
            android:padding="12dp"
            android:textColor="#2C3E50"
            android:inputType="textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="@string/label_moisture_range_slider"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvSliderValuesDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:text="40% - 70%"
                android:textAlignment="viewEnd"
                android:textColor="#2980B9"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/sliderMoistureRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            app:values="@array/initial_slider_values"
            app:thumbColor="#3498DB"
            app:trackColorActive="#3498DB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_max_watering"
            android:textColor="#2C3E50"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMaxWatering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="#F4F6F9"
            android:padding="12dp"
            android:hint="@string/hint_seconds"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cooldown_interval"
            android:textColor="#2C3E50"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCooldownInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F4F6F9"
            android:padding="12dp"
            android:hint="@string/hint_minutes"
            android:inputType="number" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveCulture"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/btn_save_settings"
        android:backgroundTint="#2ECC71"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:elevation="4dp" />

</LinearLayout>